# Application Settings
APP_NAME=Human Nutrition AI
APP_VERSION=1.0.0
DEBUG=false

# Server Configuration
HOST=127.0.0.1
PORT=8001

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*

# RAG Configuration
PDF_PATH=data/HumanNutrition.pdf
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVER_K=3

# LLM Settings
LLM_MODEL=tinyllama
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths
STATIC_DIR=static
